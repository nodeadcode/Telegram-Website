import os, json, asyncio
from datetime import datetime
from fastapi import FastAPI, HTTPException
from telethon import TelegramClient
from telethon.errors import SessionPasswordNeededError
from telethon.sessions import StringSession

app = FastAPI()

DATA_DIR = "data"
USERS_DIR = f"{DATA_DIR}/users"
SESSIONS_DIR = f"{DATA_DIR}/sessions"

os.makedirs(USERS_DIR, exist_ok=True)
os.makedirs(SESSIONS_DIR, exist_ok=True)

MAX_GROUPS = 10
GROUP_DELAY = 100
MIN_CYCLE_DELAY = 20 * 60
MIN_MESSAGE_DELAY = 60

clients = {}
running_tasks = {}

# ---------------- UTILS ---------------- #

def user_file(phone):
    return f"{USERS_DIR}/{phone}.json"

def load_user(phone):
    if not os.path.exists(user_file(phone)):
        return {}
    return json.load(open(user_file(phone)))

def save_user(phone, data):
    json.dump(data, open(user_file(phone), "w"), indent=2)

def is_night():
    h = datetime.now().hour
    return h >= 23 or h < 7

# ---------------- LOGIN ---------------- #

@app.post("/api/login/send-otp")
async def send_otp(data: dict):
    phone = data["phone"]
    api_id = int(data["api_id"])
    api_hash = data["api_hash"]

    client = TelegramClient(
        f"{SESSIONS_DIR}/{phone}",
        api_id,
        api_hash
    )
    await client.connect()
    await client.send_code_request(phone)

    clients[phone] = client
    save_user(phone, {
        "phone": phone,
        "api_id": api_id,
        "api_hash": api_hash,
        "groups": [],
        "stats": {}
    })
    return {"status": "otp_sent"}

@app.post("/api/login/verify-otp")
async def verify_otp(data: dict):
    phone = data["phone"]
    otp = data["otp"]
    client = clients.get(phone)

    try:
        await client.sign_in(phone, otp)
        return {"need_password": False}
    except SessionPasswordNeededError:
        return {"need_password": True}

@app.post("/api/login/verify-password")
async def verify_password(data: dict):
    phone = data["phone"]
    password = data["password"]
    client = clients.get(phone)

    await client.sign_in(password=password)
    return {"status": "logged_in"}

# ---------------- CONFIG ---------------- #

@app.post("/api/account/config")
def save_config(data: dict):
    phone = data["phone"]
    groups = data["groups"]

    if len(groups) > MAX_GROUPS:
        raise HTTPException(400, "Max 10 groups")

    user = load_user(phone)
    user["groups"] = groups
    save_user(phone, user)
    return {"status": "saved"}

# ---------------- BOT ---------------- #

async def forward_loop(phone):
    user = load_user(phone)
    client = clients[phone]

    while True:
        if is_night():
            await asyncio.sleep(600)
            continue

        msgs = await client.get_messages("me", limit=1)
        if not msgs:
            await asyncio.sleep(300)
            continue

        msg = msgs[0]

        for g in user["groups"]:
            try:
                await client.forward_messages(g, msg)
                user["stats"]["total"] = user["stats"].get("total", 0) + 1
                save_user(phone, user)
                await asyncio.sleep(GROUP_DELAY)
            except:
                user["groups"].remove(g)
                save_user(phone, user)

        await asyncio.sleep(MIN_CYCLE_DELAY)

@app.post("/api/account/start")
async def start_account(data: dict):
    phone = data["phone"]
    if phone in running_tasks:
        return {"status": "already_running"}

    task = asyncio.create_task(forward_loop(phone))
    running_tasks[phone] = task
    return {"status": "started"}

@app.post("/api/account/stop")
async def stop_account(data: dict):
    phone = data["phone"]
    task = running_tasks.pop(phone, None)
    if task:
        task.cancel()
    return {"status": "stopped"}
